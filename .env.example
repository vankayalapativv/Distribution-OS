# ============================================================================
# Distribution OS — environment configuration
# ----------------------------------------------------------------------------
# Copy to `.env` for local dev. In production, API values are Cloudflare Worker
# secrets (`wrangler secret put NAME`), not this file. Every variable the code
# reads is listed here (architecture audit G-0502). [required] must be set;
# [optional] have safe defaults.
# ============================================================================

# --- API (Cloudflare Worker: apps/api) --------------------------------------

# [required] Neon Postgres connection string (use the POOLED endpoint).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# [required] Neon Managed Auth JWKS endpoint — the API verifies EdDSA JWTs here.
NEON_JWKS_URL="https://<your-neon-auth-domain>/.well-known/jwks.json"

# [optional] Deployment label surfaced in responses/health (default: development).
ENVIRONMENT="development"
# [optional] API version string surfaced at GET / (default: v1).
API_VERSION="v1"
# [optional] Health monitor: ms above which a component is "degraded".
HEALTH_DEGRADED_MS="1500"

# --- API third-party integrations -------------------------------------------

# [required for maps/geocoding] Google Geocoding API key.
GOOGLE_GEOCODING_API_KEY="your-google-geocoding-key"

# [required for email] Resend transactional email.
RESEND_API_KEY="re_..."
ALERT_FROM="Distribution OS Alerts <alerts@updates.example.com>"
REPORTS_FROM="Distribution OS Reports <reports@updates.example.com>"
REPORTS_TO="recipient@example.com"
REPORTS_WEB_BASE_URL="https://app.example.com"

# [required for web push] VAPID keys for browser push (generate with web-push).
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Note: the R2 photos bucket is a wrangler binding named PHOTOS (see
# apps/api/wrangler.jsonc), not an environment variable.

# --- Web dashboard (Next.js: apps/web) --------------------------------------

# [required] Neon Auth base URL + the browser origin the web app runs on.
NEON_AUTH_BASE_URL="https://<your-neon-auth-domain>"
NEON_AUTH_WEB_ORIGIN="http://localhost:3000"
# [required] Where the web app calls the API.
DISTRIBUTION_OS_API_BASE_URL="http://localhost:8787/api/v1"
# [optional] Sign-in route used by the Neon Auth SDK.
NEXT_PUBLIC_NEON_AUTH_LOGIN_URL="/api/auth/sign-in"

# --- Mobile app (Expo: apps/mobile) -----------------------------------------
# EXPO_PUBLIC_* are embedded in the client bundle — never put secrets here.

# [required] Where the mobile app calls the API.
EXPO_PUBLIC_API_URL="http://localhost:8787/api/v1"
# [required] Neon Auth base URL + origin for the mobile auth flow.
EXPO_PUBLIC_NEON_AUTH_BASE_URL="https://<your-neon-auth-domain>"
EXPO_PUBLIC_NEON_AUTH_ORIGIN="https://<your-neon-auth-domain>"

# apps/web — PostHog error monitoring (exceptions only). Public ingestion key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
