{
  "name": "@distribution-os/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "health": "tsc && node dist/health.js",
    "seed:dev": "tsc && node dist/seed-dev.js",
    "migrate": "tsc && node dist/migrate.js",
    "setup": "tsc && node dist/setup.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No lint configured yet\""
  },
  "dependencies": {
    "postgres": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest"
  }
}
